# ============================================================
# SKYO — local environment (NEVER commit this file)
# ============================================================
APP_NAME_DEFAULT=SKYO
APP_URL=http://localhost:3000
NODE_ENV_NOTE=

# ---------- MySQL (XAMPP / phpMyAdmin) ----------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASS=
DB_NAME=skyo

# ---------- Security secrets (auto-generated, 256-bit) ----------
# Pepper for OTP hashes + blind indexes (email/phone lookup). Rotating breaks lookups.
APP_HMAC_SECRET=
# Local AES-256-GCM key used ONLY when AWS_KMS_KEY_ID is blank (dev fallback).
APP_LOCAL_DATA_KEY=

# ---------- AWS (from test/s3upload.php) ----------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_BUCKET_FOLDER=
AWS_BASE_URL=
# KMS key id / ARN for envelope encryption of PII — fill this in to switch from local key to KMS
AWS_KMS_KEY_ID=

# ---------- ZeptoMail (copied from merchant project) ----------
ZEPTO_MAIL_URL=
ZEPTO_MAIL=
ZEPTO_REGISTER_EMAIL_OTP=
ZEPTO_VERIFY_EMAIL_OTP=
ZEPTO_FORGOT_EMAIL_OTP=
ZEPTO_WELCOME_EMAIL_OTP=
ZEPTO_VERIFIED_EMAIL=
ZEPTO_FROM_EMAIL=
ZEPTO_FROM_NAME=SKYO

# ---------- Fast2SMS (copied from merchant project) ----------
FAST_SMS_URL=
FAST2SMS=
FAST2SMS_ROUTE=dlt
FAST2SMS_SENDER_ID=
FAST2SMS_TEMPLATE_ID=

# ---------- OTP / sessions ----------
OTP_TTL_SECONDS=300
# Dev only: also print OTPs to the server console (ignored when NODE_ENV=production)
OTP_DEV_ECHO=
OTP_DRY_RUN=
USER_SESSION_DAYS=180
ADMIN_SESSION_HOURS=12
ADMIN_IDLE_MINUTES=30

# ---------- Seed admin (used by npm run db:setup) ----------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------- RailCore (train data) ----------
RK_LIVE=
RK_BASE_URL=https://ir.railcore.tech/v1
RK_PLAN=free
RK_DAILY_CREDIT_CAP=80

# ---------- Razorpay (payments) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# ---------- Tripgic (ticket issuance) ----------
TRIPGIC_BASE_URL=
TRIPGIC_API_KEY=
TRIPGIC_MODE=mock
# Public base URL used for webhooks/receipts (https in production)
PUBLIC_BASE_URL=

# S3 key prefix for customer files (<prefix><SKYO_ID>/...). Default: AWS_BUCKET_FOLDER + "skyo/"
SKYO_S3_PREFIX=
# Resend (booking emails)
RESEND_API_KEY=
RESEND_FROM=
# Booking SMS (Fast2SMS DLT template id; blank = Quick SMS route)
FAST2SMS_BOOKING_TEMPLATE_ID=
